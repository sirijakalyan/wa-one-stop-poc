# Copy to server/.env for local development. Never commit server/.env.
# Leave DATABASE_URL empty to use JSON files in server/data instead of PostgreSQL.
DATABASE_URL=
# Local Postgres example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/checklist_app
# Neon example:           postgresql://USER:YOUR_PASSWORD@HOST/checklist_app?sslmode=require

# Locks the Admin screen. Required in production. Use a long random string.
ADMIN_KEY=

# Accounts. Anyone who signs up with one of these emails (comma separated) becomes an admin and sees the Users area.
# Create the account first with this email, or sign in again after adding it. Admins can then make others admins in the app.
ADMIN_EMAILS=
# Forgot-password emails go through the same email settings as reminders (EMAIL_PROVIDER below). PUBLIC_URL must be the address
# people open in the browser (the link in the email starts with it). Leave DEMO_RESET_LINKS unset on a real server.
# DEMO_RESET_LINKS=true   (only for a demo with no email service: shows the reset link on screen)

# Comma-separated list of allowed browser origins. Empty allows any origin (local dev only).
CORS_ORIGINS=

# Local: OLLAMA_BASE_URL=http://localhost:11434 (run: ollama pull llama3.2:3b). Leave empty on the free host.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b

# Optional email reminders (opt-in, confirmed by link, unsubscribe in every email).
# log    = print emails to this server's log. Nothing is delivered. Good for local testing.
# resend = send through Resend. Needs RESEND_API_KEY and a verified sender in EMAIL_FROM.
EMAIL_PROVIDER=log
# RESEND_API_KEY=
# EMAIL_FROM=WA One-Stop <reminders@your-verified-domain.example>
# Public base URL of this API, used in confirm and unsubscribe links.
PUBLIC_URL=http://localhost:3001

# Other ways to send real email (use ONE EMAIL_PROVIDER). Never commit real keys or passwords.
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=            (create it in SendGrid, and verify a sender there)
# EMAIL_FROM=WA One-Stop <your-verified-sender@yourdomain.example>
#
# EMAIL_PROVIDER=smtp          (your own mailbox, for example Zoho)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=                   (an app password, not your normal password)
